/* SPDX-License-Identifier: GPL-3.0-only */
/* ============================================================================================================
   Fluvi design system ("rio à noite"). Extend this file; screens must not hardcode values.

   Brand. Fluvi comes from the Latin fluvius, river: the console's stream flowing to this PC. The screens are deep
   river water at night lit by one warm lantern. Never brand anything as "Xbox" (console model names are data).
   Logo = .brand: the mark (a lantern-amber tile with three staggered current lines) + the "Fluvi" wordmark.
   Use .brand in every top bar; .brand.large on the sign-in screen. Source art: assets/ui/brand/fluvi-mark.svg.

   Colour roles. --brand (amber) is the only interactive colour: focus, primary action, selected, on-switches.
   --alive (moss) only means alive: console on, live stream, a good path. --danger (coral) only means failure.
   Text: --foam (primary), --bank (secondary), --silt (tertiary). Surfaces are tints of the water (--water*),
   not boxes; console tiles use --tile. Glass panels: --glass + backdrop-filter var(--blur-lg).

   Tokens (all on body, inherited):
     colour   --brand* --alive* --danger* --bed* --tile* --water* --track* --line* --foam --bank --silt --glass*
              --paper* --skeleton* (plus full box-shadow values --shadow-* / --glow-*)
     spacing  --s0..--s10 (2 4 8 12 16 24 32 48 64 96 128 dp) + half steps --s1h 6, --s2h 10, --s3h 14;
              --margin (112 dp: the bank every screen starts from)
     radius   --r-hair 2, --r-chip 6, --r-row 12, --r-tile 22, --r-panel 30, --r-pill
     type     --t-xs 14, --t-sm 16, --t-md 20, --t-lg 25, --t-xl 31, --t-display 44, --t-2xl 56, --t-stat 84, --t-hero 112
     motion   --d-fast .16s (hover/focus), --d-base .2s (fades, switches), --d-slow .3s (panels), --d-fill .5s,
              --d-enter .4s (screen arrival), --d-spin .9s, --d-breathe 1.2s, --d-loop 1.4s (shimmer, current)
     blur     --blur-sm, --blur-lg

   Components: .topbar (+ .right), .brand (.large), .hints (bottom-left key hints) + .keycap, button (.primary .ghost
   .danger .disabled), .notice (failure banner), .lead .muted .faint .label-brand, .rule-brand, .spinner, .switch (.on)
   + .knob, .meter + .fill, .live (+ .led), .led (.alive), .arrive (one entrance per screen), body.solid (app background),
   scrollbars (thin thumb; required for any overflow: auto box).
   Focusables: button .tile .row .seg .toggle get tab-index/nav/focus here; focus = brand border + --glow-focus.

   Skeletons (loading states): put the real layout in place with placeholder shapes, shown with data-if on a model
   flag (sign.pending, cons.loading, cons.refreshing && !cons.has_account, conn.loading, set.loaded, stream.has_stats):
     .skeleton             base: shimmering block (any size you give it)
     .skeleton-line        one line of text (height 1em-ish); modifiers .w-40 .w-60 .w-80 set the width; .tall for headings
     .skeleton-circle      avatar / LED / dot
     .skeleton-card        a placeholder tile shaped like .tile (put .skeleton-line children inside)
     .skeleton-block       a square/rect media placeholder (QR, images)
   Never build a one-off placeholder in a screen: add a modifier here.
   Sizes in dp, laid out for 1920x1080; the app sets dp = window scale. Fonts are loaded by Ui.cpp (LoadFontFace).
   ============================================================================================================ */

/* ---- Element defaults (RmlUi has no user-agent sheet) ---- */
div, p, h1, h2, h3, section, header, footer { display: block; }
span, em, strong { display: inline; }
strong { font-weight: bold; }
img { display: inline-block; }

/* ---- Tokens ---- */
body
{
	/* brand: the lantern */
	--brand:          #f4b860;
	--brand-hi:       #ffd08a;
	--brand-deep:     #e0973d;
	--brand-soft:     #f4b86026;
	--brand-edge:     #fff3df;
	--brand-ink:      #2b1a05;
	--brand-rule:     #f4b860b3;
	--brand-clear:    #f4b86000;
	--brand-haze:     #f4b8601f;
	--brand-half:     #f4b86066;
	--brand-spark:    #ffe2b0;

	/* state */
	--alive:          #6fd3a5;
	--alive-soft:     #6fd3a522;
	--danger:         #ff7a6e;
	--danger-soft:    #ff7a6e22;
	--danger-hover:   #ff7a6e38;
	--danger-dim:     #ff7a6e66;
	--danger-mid:     #ff7a6e88;
	--danger-text:    #ffc2bb;

	/* water */
	--bed:            #071419;
	--bed-top:        #0a1b21;
	--bed-bottom:     #050f13;
	--bed-veil:       #071419a6;
	--bed-frost:      #071419e6;
	--reflection:     #2a8fa024;
	--reflection-clear: #2a8fa000;
	--tile:           #0f242bcc;
	--tile-hi:        #132c34;
	--water:          #ffffff08;
	--water-hi:       #ffffff12;
	--water-press:    #ffffff1c;
	--track:          #ffffff1f;
	--track-dim:      #ffffff14;
	--divider:        #ffffff0d;
	--line:           #cfe7e914;
	--line-hi:        #cfe7e92e;
	--glass:          #08171cc4;
	--glass-line:     #cfe7e921;
	--scrim:          #02080a99;
	--scrim-clear:    #02080a00;
	--paper:          #f3f7f5;
	--paper-ink:      #3d5258;
	--knob-on:        #fff8ec;
	--ghost-text:     #ffffff1a;
	--skeleton:       #ffffff0b;
	--skeleton-hi:    #ffffff1e;

	/* text */
	--foam:           #e6efec;
	--bank:           #8fa6a8;
	--silt:           #587177;

	/* elevation and glow (full box-shadow values) */
	--glow-focus:        #f4b86040 0dp 0dp 24dp 0dp;
	--glow-focus-strong: #f4b86073 0dp 0dp 32dp 0dp;
	--glow-row:          #f4b86026 0dp 0dp 28dp 0dp;
	--glow-danger:       #ff7a6e40 0dp 0dp 24dp 0dp;
	--glow-alive:        #6fd3a5aa 0dp 0dp 12dp 0dp;
	--glow-done:         #f4b86066 0dp 0dp 16dp 0dp;
	--shadow-tile:       #00000099 0dp 26dp 50dp 0dp, #f4b86033 0dp 0dp 36dp 0dp;
	--shadow-panel:      #00000080 0dp 30dp 60dp 0dp;
	--shadow-paper:      #00000080 0dp 30dp 70dp 0dp, #f4b86014 0dp 0dp 0dp 10dp;

	/* spacing */
	--s0: 2dp;  --s1: 4dp;  --s1h: 6dp; --s2: 8dp;  --s2h: 10dp; --s3: 12dp; --s3h: 14dp; --s4: 16dp;
	--s5: 24dp; --s6: 32dp; --s7: 48dp; --s8: 64dp; --s9: 96dp; --s10: 128dp;
	--margin: 112dp;

	/* radius: small things are round, surfaces are soft, panels are softer */
	--r-hair: 2dp; --r-chip: 6dp; --r-row: 12dp; --r-tile: 22dp; --r-panel: 30dp; --r-pill: 999dp;

	/* type (1.25 steps from 16) */
	--t-xs: 14dp; --t-sm: 16dp; --t-md: 20dp; --t-lg: 25dp; --t-xl: 31dp; --t-display: 44dp; --t-2xl: 56dp;
	--t-stat: 84dp; --t-hero: 112dp;

	/* motion */
	--d-fast: 0.16s; --d-base: 0.2s; --d-slow: 0.3s; --d-fill: 0.5s; --d-enter: 0.4s;
	--d-spin: 0.9s; --d-breathe: 1.2s; --d-loop: 1.4s;

	/* blur */
	--blur-sm: 10dp; --blur-lg: 30dp;

	font-family: "Inter";
	font-weight: normal;
	font-size: var(--t-md);
	line-height: 1.4;
	color: var(--foam);
	width: 100%;
	height: 100%;
	margin: 0;
	padding: 0;
}

/* Full-bleed screens without a stream behind: dark water, the lantern's glow upstream, a cold reflection downstream. */
body.solid
{
	background-color: var(--bed);
	decorator: radial-gradient(circle 1200dp at 8% -18%, var(--brand-haze), var(--brand-clear)),
	           radial-gradient(circle 1000dp at 104% 118%, var(--reflection), var(--reflection-clear)),
	           linear-gradient(180deg, var(--bed-top), var(--bed-bottom));
}

/* ---- Brand ---- */
.brand { display: flex; flex-direction: row; align-items: center; gap: var(--s3); }
.brand-mark
{
	position: relative;
	width: 40dp; height: 40dp;
	border-radius: var(--r-row);
	decorator: linear-gradient(150deg, var(--brand-hi), var(--brand-deep));
}
/* Three staggered current lines: the stream flowing left to right. */
.brand-mark .w { position: absolute; height: 4dp; border-radius: 2dp; background-color: var(--brand-ink); }
.brand-mark .w1 { top: 11dp; left: 8dp;  width: 20dp; }
.brand-mark .w2 { top: 18dp; left: 14dp; width: 18dp; }
.brand-mark .w3 { top: 25dp; left: 9dp;  width: 13dp; }
.brand-name
{
	font-family: "Inter Display";
	font-weight: bold;
	font-size: var(--t-xl);
	letter-spacing: -0.5dp;
	color: var(--foam);
}
.brand-tag { font-size: var(--t-sm); color: var(--bank); }
.brand.large { gap: var(--s4); }
.brand.large .brand-mark { width: 56dp; height: 56dp; border-radius: 17dp; }
.brand.large .brand-mark .w { height: 5dp; border-radius: 3dp; }
.brand.large .brand-mark .w1 { top: 15dp; left: 11dp; width: 28dp; }
.brand.large .brand-mark .w2 { top: 25dp; left: 20dp; width: 25dp; }
.brand.large .brand-mark .w3 { top: 35dp; left: 13dp; width: 18dp; }
.brand.large .brand-name { font-size: 38dp; }

/* ---- Typography ---- */
h1
{
	font-family: "Inter Display";
	font-weight: bold;
	font-size: var(--t-2xl);
	letter-spacing: -1.2dp;
	line-height: 1.08;
	color: var(--foam);
}
h2 { font-weight: 600; font-size: var(--t-lg); color: var(--foam); }
.display { font-family: "Inter Display"; font-weight: bold; letter-spacing: -0.8dp; line-height: 1.05; }
.lead { font-size: var(--t-lg); line-height: 1.45; color: var(--bank); }
.muted { color: var(--bank); }
.faint { color: var(--silt); }
.label-brand { font-weight: 600; color: var(--brand); }
.rule-brand { height: 2dp; decorator: linear-gradient(90deg, var(--brand-rule), var(--brand-clear)); }

/* ---- Scrollbars: RmlUi needs them sized, or an unstyled vertical bar takes the whole content width and every
   child of an overflow: auto box shrinks to nothing. A thin rounded thumb, no track, no arrows. ---- */
scrollbarvertical { width: var(--s1h); margin-left: var(--s2); }
scrollbarhorizontal { height: var(--s1h); margin-top: var(--s2); }
scrollbarvertical slidertrack, scrollbarhorizontal slidertrack { background-color: transparent; }
scrollbarvertical slidertrack, scrollbarvertical sliderbar { width: var(--s1h); }
scrollbarvertical sliderbar { min-height: var(--s7); }
scrollbarhorizontal slidertrack, scrollbarhorizontal sliderbar { height: var(--s1h); }
scrollbarhorizontal sliderbar { min-width: var(--s7); }
scrollbarvertical sliderbar, scrollbarhorizontal sliderbar
{
	border-radius: var(--r-pill);
	background-color: var(--water-hi);
	transition: background-color var(--d-fast) cubic-out;
}
scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active,
scrollbarhorizontal sliderbar:hover, scrollbarhorizontal sliderbar:active { background-color: var(--silt); }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0dp; height: 0dp; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0dp; height: 0dp; }
scrollbarcorner { width: 0dp; height: 0dp; }

/* ---- Interactive elements: all focusable and D-pad navigable ---- */
button, .tile, .row, .seg, .toggle
{
	tab-index: auto;
	nav: auto;
	focus: auto;
	cursor: pointer;
}

button
{
	display: inline-block;
	box-sizing: border-box;
	height: 56dp;
	line-height: 52dp;
	padding: 0dp 28dp;
	border-radius: var(--r-pill);
	font-size: var(--t-sm);
	font-weight: 600;
	text-align: center;
	color: var(--foam);
	background-color: var(--water-hi);
	border: 2dp transparent;
	transition: background-color color border-color transform var(--d-fast) cubic-out;
}
button:hover { background-color: var(--water-press); }
button:focus-visible { border-color: var(--brand); background-color: var(--water-press); box-shadow: var(--glow-focus); }
button:active { transform: scale(0.97); }

button.primary { color: var(--brand-ink); background-color: var(--brand); }
button.primary:hover { background-color: var(--brand-hi); }
button.primary:focus-visible { background-color: var(--brand-hi); border-color: var(--brand-edge); box-shadow: var(--glow-focus-strong); }

button.ghost { background-color: transparent; color: var(--bank); }
button.ghost:hover { color: var(--foam); background-color: var(--water); }
button.ghost:focus-visible { color: var(--foam); }

button.danger { color: var(--danger); background-color: var(--danger-soft); }
button.danger:hover { background-color: var(--danger-hover); }
button.danger:focus-visible { border-color: var(--danger); box-shadow: var(--glow-danger); }

button.disabled, button.disabled:hover { opacity: 0.4; cursor: arrow; }

/* A key or button on the keyboard/controller, inline in a hint. */
.keycap
{
	display: inline-block;
	min-width: 18dp;
	padding: 1dp var(--s2) 3dp var(--s2);
	margin: 0dp 6dp;
	border-radius: var(--r-chip);
	border: 1dp var(--line-hi);
	border-bottom-width: 3dp;
	background-color: var(--water);
	font-size: var(--t-xs);
	font-weight: 600;
	text-align: center;
	color: var(--foam);
}

/* Bottom-left key hints shared by the full screens. */
.hints
{
	position: absolute;
	left: var(--margin);
	bottom: var(--s6);
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: var(--s5);
	font-size: var(--t-xs);
	color: var(--silt);
}

/* Failure banner (consoles error, stream warning). */
.notice
{
	padding: var(--s3) var(--s4);
	border-radius: var(--r-row);
	border-left: 4dp var(--danger);
	background-color: var(--danger-soft);
	color: var(--danger-text);
}

/* ---- Top bar shared by the full screens ---- */
.topbar
{
	position: absolute;
	top: 0dp; left: 0dp; right: 0dp;
	height: 120dp;
	padding: 0dp var(--s8) 0dp var(--margin);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}
.topbar .right { display: flex; flex-direction: row; align-items: center; gap: var(--s2); }

/* ---- Status dots ---- */
.led { width: 10dp; height: 10dp; border-radius: 5dp; background-color: var(--silt); }
.led.alive { background-color: var(--alive); box-shadow: var(--glow-alive); }
.live { display: flex; flex-direction: row; align-items: center; gap: var(--s2); font-size: var(--t-xs); font-weight: 600; color: var(--alive); }
.live .led { width: 8dp; height: 8dp; border-radius: 4dp; background-color: var(--alive); box-shadow: var(--glow-alive); animation: var(--d-breathe) breathe infinite alternate cubic-in-out; }

/* ---- Motion ---- */
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes breathe { from { opacity: 0.35; } to { opacity: 1; } }
@keyframes arrive { from { opacity: 0; transform: translateY(14dp); } to { opacity: 1; transform: translateY(0dp); } }

.spinner
{
	display: inline-block;
	width: 20dp;
	height: 20dp;
	border-radius: 10dp;
	border: 3dp var(--track);
	border-top-color: var(--brand);
	animation: var(--d-spin) spin infinite linear;
}

/* Each screen arrives once, as a whole. */
.arrive { animation: var(--d-enter) arrive cubic-out; }

/* ---- Switch (settings + overlay) ---- */
.switch
{
	width: 52dp; height: 30dp;
	border-radius: 15dp;
	background-color: var(--track);
	transition: background-color var(--d-base) cubic-out;
}
.switch .knob
{
	margin: var(--s1);
	width: 22dp; height: 22dp;
	border-radius: 11dp;
	background-color: var(--bank);
	transition: transform background-color var(--d-base) cubic-out;
}
.switch.on { background-color: var(--brand); }
.switch.on .knob { transform: translateX(22dp); background-color: var(--knob-on); }

/* ---- Meter (settings levels) ---- */
.meter { margin: var(--s2) auto 0dp auto; width: 150dp; height: 4dp; border-radius: 2dp; background-color: var(--track-dim); }
.meter .fill { height: 4dp; border-radius: 2dp; background-color: var(--brand); transition: width var(--d-fast) cubic-out; }

/* ---- Skeletons ---- */
@keyframes shimmer
{
	from { decorator: linear-gradient(100deg, var(--skeleton) -40%, var(--skeleton-hi) -20%, var(--skeleton) 0%); }
	to   { decorator: linear-gradient(100deg, var(--skeleton) 100%, var(--skeleton-hi) 120%, var(--skeleton) 140%); }
}
.skeleton, .skeleton-line, .skeleton-circle, .skeleton-card, .skeleton-block
{
	display: block;
	background-color: var(--skeleton);
	border-radius: var(--r-chip);
	animation: var(--d-loop) shimmer infinite linear;
}
.skeleton-line { height: 0.8em; margin: 0.3em 0dp; width: 100%; }
.skeleton-line.tall { height: 1em; }
.skeleton-line.w-20 { width: 20%; }
.skeleton-line.w-40 { width: 40%; }
.skeleton-line.w-60 { width: 60%; }
.skeleton-line.w-80 { width: 80%; }
.skeleton-circle { border-radius: var(--r-pill); }
.skeleton-card
{
	box-sizing: border-box;
	padding: var(--s6) var(--s6) var(--s5) var(--s6);
	border-radius: var(--r-tile);
	border: 2dp var(--line);
	background-color: var(--tile);
	animation: none;   /* the card is the still shape; its lines shimmer */
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.skeleton-block { border-radius: var(--r-panel); }
.skeleton-line.hero { height: var(--t-hero); width: 640dp; margin: var(--s2) 0dp 0dp 0dp; border-radius: var(--r-row); }
.skeleton-line.display { height: var(--t-display); border-radius: var(--r-row); }
.skeleton-line.chip { height: 46dp; width: 140dp; border-radius: var(--r-pill); margin: 0dp; }
/* A list-row placeholder (settings rows): label lines on the left, value on the right. */
.skeleton-card.flat
{
	flex-direction: row;
	align-items: center;
	gap: var(--s6);
	min-height: 80dp;
	margin-bottom: 6dp;
	padding: var(--s3) var(--s5);
	border-width: 0dp;
	border-radius: var(--r-row);
	background-color: var(--water);
}
.skeleton-card.flat > div { flex: 1; }
.skeleton-card.flat .skeleton-line.chip { flex: none; width: 180dp; height: 34dp; }
