<rml>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<head>
	<title>Consoles</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		/* Layout only: values come from theme.rcss tokens. */
		.account
		{
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: var(--s3);
			margin-left: var(--s3);
			padding: var(--s1h) var(--s5) var(--s1h) var(--s1h);
			border-radius: var(--r-pill);
			background-color: var(--water);
			font-size: var(--t-sm);
			font-weight: 600;
		}
		.avatar
		{
			width: 38dp; height: 38dp; border-radius: var(--r-pill);
			line-height: 38dp; text-align: center;
			font-weight: bold;
			color: var(--brand-ink);
			decorator: linear-gradient(150deg, var(--brand-hi), var(--brand-deep));
		}
		.account-skeleton { margin-left: var(--s3); width: 180dp; }

		.page { position: absolute; top: 200dp; left: var(--margin); right: var(--margin); bottom: 0dp; }
		.heading { display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; }
		.heading .lead { margin-top: var(--s3); }
		.searching { display: flex; flex-direction: row; align-items: center; gap: var(--s3); color: var(--bank); font-size: var(--t-sm); padding-bottom: var(--s1h); }
		.page .notice { margin-top: var(--s5); width: 960dp; }

		.shelf { margin-top: var(--s8); display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--s5); }
		.tile-size { width: 400dp; height: 300dp; }

		/* One tile per console: the room name is what people recognise, so it is the largest thing on it. */
		.tile
		{
			position: relative;
			box-sizing: border-box;
			padding: var(--s6) var(--s6) var(--s5) var(--s6);
			border-radius: var(--r-tile);
			background-color: var(--tile);
			border: 2dp var(--line);
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			transition: background-color border-color transform var(--d-fast) cubic-out;
		}
		.tile:hover { background-color: var(--tile-hi); }
		.tile:focus-visible
		{
			border-color: var(--brand);
			background-color: var(--tile-hi);
			transform: translateY(-6dp);
			box-shadow: var(--shadow-tile);
		}
		.tile.busy { opacity: 0.85; }

		.state { display: flex; flex-direction: row; align-items: center; gap: var(--s2h); font-size: var(--t-sm); font-weight: 600; color: var(--silt); }
		.tile.on .state { color: var(--alive); }
		.tile .name { font-size: var(--t-display); }
		.tile .model { margin-top: var(--s1h); font-size: var(--t-sm); color: var(--bank); }

		.go { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
		.cta
		{
			height: 46dp; line-height: 46dp; padding: 0dp var(--s5);
			border-radius: var(--r-pill);
			font-size: var(--t-sm); font-weight: 600;
			background-color: var(--water-hi);
			color: var(--foam);
			transition: background-color color var(--d-fast) cubic-out;
		}
		.tile:focus-visible .cta, .tile:hover .cta { background-color: var(--brand); color: var(--brand-ink); }
		.waiting { display: flex; flex-direction: row; align-items: center; gap: var(--s3); color: var(--bank); font-size: var(--t-sm); }


		.empty { margin-top: var(--s8); width: 720dp; }
		.empty h2 { margin-bottom: var(--s3); }
		.empty .muted { line-height: 1.5; }
	</style>
</head>
<body class="solid" data-model="fluvi">
	<div class="topbar">
		<div class="brand">
			<div class="brand-mark"><div class="w w1"></div><div class="w w2"></div><div class="w w3"></div></div>
			<div class="brand-name">Fluvi</div>
		</div>
		<div class="right">
			<button class="ghost" id="consoles-refresh" data-event-click="refresh_consoles" data-class-disabled="cons.refreshing">Atualizar lista</button>
			<button class="ghost" id="consoles-settings" data-event-click="open_settings">Configurações</button>
			<button class="ghost" id="consoles-signout" data-event-click="sign_out">Sair da conta</button>
			<div class="account" data-if="cons.has_account">
				<div class="avatar">{{ cons.initial }}</div>
				<span>{{ cons.account }}</span>
			</div>
			<div class="skeleton-line chip account-skeleton" data-if="!cons.has_account &amp;&amp; (cons.loading || cons.refreshing)"></div>
		</div>
	</div>

	<div class="page arrive">
		<div class="heading">
			<div>
				<h1>Seus consoles</h1>
				<div class="lead">Escolha onde jogar. O console precisa estar com o Remote Play ativado.</div>
			</div>
			<div class="searching" data-if="cons.refreshing"><div class="spinner"></div><span>Procurando consoles</span></div>
		</div>

		<div class="notice" data-if="cons.error != ''">{{ cons.error }}</div>

		<div class="shelf">
			<div class="tile tile-size" data-for="c : cons.list" data-attr-id="'console-' + it_index" autofocus=""
			     data-class-on="c.on" data-class-busy="c.busy" data-event-click="pick(c.id)">
				<div class="state"><div class="led" data-class-alive="c.on"></div><span>{{ c.power }}</span></div>
				<div>
					<div class="name display">{{ c.name }}</div>
					<div class="model">{{ c.type }}</div>
				</div>
				<div class="go">
					<div class="waiting" data-if="c.busy"><div class="spinner"></div><span>Aguarde</span></div>
					<div class="cta" data-if="!c.busy">{{ c.action }}</div>
				</div>
			</div>

			<!-- Placeholders in the tiles' real shape while the first list (or an empty refresh) is pending. -->
			<div class="skeleton-card tile-size" data-if="cons.loading">
				<div class="skeleton-line w-40"></div>
				<div><div class="skeleton-line display w-60"></div><div class="skeleton-line w-40"></div></div>
				<div class="skeleton-line chip"></div>
			</div>
			<div class="skeleton-card tile-size" data-if="cons.loading">
				<div class="skeleton-line w-40"></div>
				<div><div class="skeleton-line display w-80"></div><div class="skeleton-line w-40"></div></div>
				<div class="skeleton-line chip"></div>
			</div>
			<div class="skeleton-card tile-size" data-if="cons.loading">
				<div class="skeleton-line w-40"></div>
				<div><div class="skeleton-line display w-60"></div><div class="skeleton-line w-40"></div></div>
				<div class="skeleton-line chip"></div>
			</div>
		</div>

		<div class="empty" data-if="cons.list.size == 0 &amp;&amp; !cons.refreshing &amp;&amp; !cons.loading">
			<h2>Nenhum console nesta conta</h2>
			<div class="muted">Ligue o console (ou deixe em modo Instantâneo), ative “Permitir Remote Play” nas configurações de dispositivos e conexões dele, e escolha Atualizar lista.</div>
		</div>
	</div>

	<div class="hints"><span><span class="keycap">←</span><span class="keycap">→</span>escolhe o console</span><span><span class="keycap">Enter</span>conecta</span></div>
</body>
</rml>
