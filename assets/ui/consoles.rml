<rml>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<head>
	<title>consoles</title>
	<link type="text/template" href="shell.rml"/>
	<style>
		/* Layout only: values come from theme.rcss tokens. */
		.account-menu { top: 76dp; right: var(--s6); }
		.chip-skeleton { width: 200dp; margin: 0dp var(--s2); }

		.page
		{
			position: absolute;
			top: var(--top); left: var(--margin); right: var(--margin); bottom: var(--s9);
			display: flex;
			flex-direction: column;
			justify-content: center;
		}
		.searching { display: flex; flex-direction: row; align-items: center; gap: var(--s3); color: var(--bank); font-size: var(--t-xs); margin-bottom: var(--s4); }
		.searching .runner { width: 160dp; }
		.page .notice { margin-bottom: var(--s5); max-width: 900dp; }

		/* One console (the usual case): the console is the whole screen. Its name is what people recognise. */
		.state { display: flex; flex-direction: row; align-items: center; gap: var(--s2h); font-weight: 600; color: var(--bank); }
		.on .state { color: var(--alive); }
		.hero .name { margin-top: var(--s3); font-size: var(--t-hero); white-space: nowrap; overflow: hidden; }
		.hero .model { margin-top: var(--s2); color: var(--silt); }
		.hero .go { margin-top: var(--s7); display: flex; flex-direction: row; align-items: center; gap: var(--s4); min-height: var(--btn); }
		.waiting { display: flex; flex-direction: row; align-items: center; gap: var(--s4); color: var(--bank); }
		.waiting .runner { width: 200dp; }
		.hero-skeleton .skeleton-line.state-line { width: 260dp; }
		.hero-skeleton .skeleton-line.hero { width: 440dp; }
		.hero-skeleton .skeleton-line.model-line { width: 180dp; }
		.hero-skeleton .skeleton-line.chip { margin-top: var(--s7); width: var(--ctl); }

		/* Several consoles: a shelf, the last one used focused. */
		.heading .lead { margin-top: var(--s2); }
		.shelf { margin-top: var(--s6); display: flex; flex-direction: row; gap: var(--s4); overflow-x: auto; padding: var(--s2) var(--s1) var(--s3) var(--s1); }
		.tile
		{
			flex: 0 0 auto;
			width: 340dp; height: 236dp;
			box-sizing: border-box;
			padding: var(--s5);
			border-radius: var(--r-tile);
			background-color: var(--tile);
			border: 2dp var(--tile-line);
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			transition: background-color border-color transform var(--d-fast) cubic-out;
		}
		.tile:hover { background-color: var(--tile-hi); }
		.tile:focus-visible { border-color: var(--brand); background-color: var(--tile-hi); transform: translateY(-4dp); box-shadow: var(--shadow-tile); }
		.tile .name { font-size: var(--t-2xl); white-space: nowrap; overflow: hidden; }
		.tile .model { margin-top: var(--s1); font-size: var(--t-xs); color: var(--silt); }
		.cta { display: flex; flex-direction: row; align-items: center; gap: var(--s2); font-weight: 600; color: var(--bank); }
		.tile:focus-visible .cta, .tile:hover .cta { color: var(--brand); }

		.empty { max-width: 760dp; }
		.empty .lead { margin-top: var(--s3); }
		.empty button { margin-top: var(--s6); }
	</style>
</head>
<body template="shell" class="solid" data-model="fluvi">
	<div class="topbar">
		<div class="brand-small" data-if="!chrome.visible"><svg class="mark" src="brand/fluvi-mark.svg"/><svg class="word" src="brand/fluvi-wordmark.svg"/></div>
		<div data-if="chrome.visible"></div>
		<div class="actions">
			<button class="ghost" id="consoles-refresh" data-event-click="refresh_consoles" data-class-disabled="cons.refreshing"><span class="icon">&#xE036;</span><span>[consoles.refresh]</span></button>
			<button class="ghost" id="consoles-settings" data-event-click="open_settings"><span class="icon">&#xE272;</span><span>[common.settings]</span></button>
			<button class="ghost" id="consoles-quit" data-event-click="quit"><span class="icon">&#xE3DA;</span><span>[common.quit]</span></button>
			<div class="chip" id="account-chip" data-if="cons.has_account" data-class-open="cons.menu" data-event-click="account_menu">
				<div class="avatar">{{ cons.initial }}</div>
				<span>{{ cons.account }}</span>
				<span class="icon">&#xE136;</span>
			</div>
			<div class="skeleton-line chip chip-skeleton" data-if="!cons.has_account &amp;&amp; (cons.loading || cons.refreshing)"></div>
		</div>
	</div>

	<div class="page arrive">
		<div class="searching" data-if="cons.refreshing &amp;&amp; !cons.loading"><div class="runner"><div class="run"></div></div><span>[consoles.searching]</span></div>
		<div class="notice" data-if="cons.error != ''"><span class="icon">&#xE4E2;</span><span>{{ cons.error }}</span></div>

		<!-- One console: a hero. -->
		<div class="hero" data-if="cons.single">
			<div data-for="c : cons.list" data-class-on="c.on">
				<div class="state"><div class="led" data-class-alive="c.on"></div><span>{{ c.power }}</span></div>
				<div class="name condensed">{{ c.name }}</div>
				<div class="model">{{ c.type }}</div>
				<div class="go">
					<button class="primary wide" autofocus="" id="console-play" data-if="!c.busy" data-event-click="pick(c.id)">
						<span class="icon" data-if="c.on">&#xE3D0;</span><span class="icon" data-if="!c.on">&#xE3DA;</span><span>{{ c.action }}</span>
					</button>
					<div class="waiting" data-if="c.busy"><div class="runner"><div class="run"></div></div><span>[consoles.waking]</span></div>
				</div>
			</div>
		</div>

		<!-- Placeholder in the hero's shape while the first list (or an empty refresh) is pending. -->
		<div class="hero-skeleton" data-if="cons.loading">
			<div class="skeleton-line state-line"></div>
			<div class="skeleton-line hero"></div>
			<div class="skeleton-line model-line"></div>
			<div class="skeleton-line chip"></div>
		</div>

		<!-- Several consoles: a shelf. -->
		<div data-if="cons.list.size > 1">
			<div class="heading">
				<h1>[consoles.title]</h1>
				<div class="lead">[consoles.lead]</div>
			</div>
			<div class="shelf">
				<div class="tile" data-for="c : cons.list" data-attr-id="'console-' + it_index"
				     data-class-on="c.on" data-event-click="pick(c.id)">
					<div class="state"><div class="led" data-class-alive="c.on"></div><span>{{ c.power }}</span></div>
					<div>
						<div class="name condensed">{{ c.name }}</div>
						<div class="model">{{ c.type }}</div>
					</div>
					<div class="cta" data-if="!c.busy"><span class="icon" data-if="c.on">&#xE3D0;</span><span class="icon" data-if="!c.on">&#xE3DA;</span><span>{{ c.action }}</span></div>
					<div class="waiting" data-if="c.busy"><div class="runner"><div class="run"></div></div></div>
				</div>
			</div>
		</div>

		<div class="empty" data-if="cons.list.size == 0 &amp;&amp; !cons.refreshing &amp;&amp; !cons.loading">
			<h1>[consoles.empty_title]</h1>
			<div class="lead">[consoles.empty_body]</div>
			<button class="primary" autofocus="" id="consoles-empty-refresh" data-event-click="refresh_consoles"><span class="icon">&#xE036;</span><span>[consoles.refresh]</span></button>
		</div>
	</div>

	<div class="menu account-menu" data-if="cons.menu">
		<div class="menu-item" id="menu-switch" data-event-click="switch_account"><span class="icon">&#xE756;</span><span>[consoles.switch_account]</span></div>
		<div class="menu-item" id="menu-signout" data-event-click="sign_out"><span class="icon">&#xE42A;</span><span>[consoles.sign_out]</span></div>
	</div>

	<div class="hints">
		<span class="hint"><span class="keycap kb">[common.key_enter]</span><span class="padkey gp">A</span><span>[consoles.hint_play]</span></span>
		<span class="hint"><span class="keycap kb">[common.key_arrows]</span><span class="padkey gp">&#xE13A;</span><span>[common.hint_move]</span></span>
	</div>
</body>
</rml>
