<rml>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<head>
	<title>signin</title>
	<link type="text/template" href="shell.rml"/>
	<style>
		/* Layout only: values come from theme.rcss tokens. */
		.page
		{
			position: absolute;
			top: var(--top); left: var(--margin); right: var(--margin); bottom: var(--s8);
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--s7);
		}
		.copy { flex: 1 1 auto; max-width: 860dp; }
		.copy h1 { font-size: var(--t-2xl); }

		/* The two steps really are a sequence, so they are numbered. */
		.steps { margin-top: var(--s5); }
		.step { display: flex; flex-direction: row; align-items: center; gap: var(--s3); margin-bottom: var(--s2); color: var(--bank); }
		.step .n
		{
			width: 32dp; height: 32dp;
			line-height: 30dp;
			border-radius: var(--r-pill);
			border: 1.5dp var(--line-hi);
			text-align: center;
			font-size: var(--t-xs);
			font-weight: 600;
		}

		/* The code is the reason this screen exists: set like a sign over the water. */
		.code { margin-top: var(--s4); font-size: var(--t-hero); letter-spacing: 6dp; color: var(--foam); white-space: nowrap; }
		.code.placeholder { color: var(--track); }
		.code-skeleton { width: 520dp; }

		.actions { margin-top: var(--s5); display: flex; flex-direction: row; gap: var(--s3); }
		.status { margin-top: var(--s4); display: flex; flex-direction: row; align-items: center; gap: var(--s3); color: var(--bank); min-height: 30dp; }
		.status.err { color: var(--danger-text); }
		.status.err .icon { color: var(--danger); }
		.status-skeleton { width: 360dp; }

		.qr-slot { flex: 0 0 auto; width: 340dp; height: 396dp; }
		.qr
		{
			box-sizing: border-box;
			padding: var(--s5);
			border-radius: var(--r-panel);
			background-color: var(--paper);
			box-shadow: var(--shadow-paper);
		}
		.qr img { display: block; width: 292dp; height: 292dp; }
		.qr .cap { margin-top: var(--s3); text-align: center; color: var(--paper-ink); font-size: var(--t-xs); font-weight: 600; }
		.qr-empty
		{
			box-sizing: border-box;
			padding: var(--s6);
			border-radius: var(--r-panel);
			border: 1.5dp var(--line);
			background-color: var(--water);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			text-align: center;
			color: var(--silt);
		}
	</style>
</head>
<body template="shell" class="solid" data-model="fluvi">
	<div class="topbar">
		<div class="brand-small" data-if="!chrome.visible"><svg class="mark" src="brand/fluvi-mark.svg"/><svg class="word" src="brand/fluvi-wordmark.svg"/></div>
		<div data-if="chrome.visible"></div>
		<div class="actions">
			<button class="ghost" id="signin-settings" data-event-click="open_settings"><span class="icon">&#xE272;</span><span>[common.settings]</span></button>
			<button class="ghost" id="signin-quit" data-event-click="quit"><span class="icon">&#xE3DA;</span><span>[common.quit]</span></button>
		</div>
	</div>

	<div class="page arrive">
		<div class="copy">
			<h1>[signin.title]</h1>
			<div class="steps">
				<div class="step"><div class="n">1</div><span>[signin.step_open]</span><span class="label-brand">{{ sign.uri_short }}</span></div>
				<div class="step"><div class="n">2</div><span>[signin.step_code]</span></div>
			</div>

			<div class="code condensed" data-if="sign.has_code">{{ sign.code }}</div>
			<div class="skeleton-line hero code-skeleton" data-if="!sign.has_code &amp;&amp; sign.pending"></div>
			<div class="code condensed placeholder" data-if="!sign.has_code &amp;&amp; !sign.pending">[signin.code_placeholder]</div>

			<div class="actions">
				<button class="primary" autofocus="" id="signin-start" data-if="!sign.busy" data-event-click="sign_in"><span class="icon">&#xE06C;</span><span>[signin.start]</span></button>
				<button class="primary" autofocus="" id="signin-browser" data-if="sign.busy &amp;&amp; sign.has_code" data-event-click="open_browser"><span class="icon">&#xE5DE;</span><span>[signin.open_browser]</span></button>
				<button id="signin-copy" data-if="sign.busy &amp;&amp; sign.has_code" data-event-click="copy_code"><span class="icon">&#xE1CC;</span><span>[signin.copy_code]</span></button>
				<button class="ghost" id="signin-cancel" data-if="sign.busy" data-event-click="cancel_sign_in"><span>[common.cancel]</span></button>
			</div>

			<div class="status" data-class-err="sign.error" data-if="!sign.pending">
				<span class="icon" data-if="sign.error">&#xE4E2;</span>
				<span data-if="sign.status != ''">{{ sign.status }}</span>
				<span data-if="sign.status == '' &amp;&amp; !sign.busy">[signin.idle]</span>
				<span data-if="sign.status == '' &amp;&amp; sign.busy">[signin.waiting]</span>
			</div>
			<div class="status" data-if="sign.pending"><div class="skeleton-line status-skeleton"></div></div>
		</div>

		<div class="qr qr-slot" data-if="sign.has_qr">
			<img data-attr-src="sign.qr"/>
			<div class="cap">[signin.qr_caption]</div>
		</div>
		<div class="skeleton-block qr-slot" data-if="!sign.has_qr &amp;&amp; sign.pending"></div>
		<div class="qr-empty qr-slot" data-if="!sign.has_qr &amp;&amp; !sign.pending">[signin.qr_empty]</div>
	</div>

	<div class="hints">
		<span class="hint"><span class="keycap kb">[common.key_enter]</span><span class="padkey gp">A</span><span>[common.hint_choose]</span></span>
		<span class="hint"><span class="keycap kb">[common.key_arrows]</span><span class="padkey gp">&#xE13A;</span><span>[common.hint_move]</span></span>
	</div>
</body>
</rml>
