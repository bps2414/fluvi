<rml>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<head>
	<title>Conectando</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		.center
		{
			position: absolute;
			top: 0dp; left: 0dp; right: 0dp; bottom: 0dp;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
		}
		.panel { width: 880dp; text-align: center; }
		.panel h1 { margin-top: var(--s3); }
		.detail { margin-top: var(--s4); font-size: var(--t-lg); color: var(--text-2); }
		.detail.err { color: var(--danger); }

		.orb
		{
			position: relative;
			margin: 0dp auto var(--s6) auto;
			width: 132dp; height: 132dp;
		}
		.orb .ring
		{
			position: absolute; top: 0dp; left: 0dp;
			width: 132dp; height: 132dp;
			box-sizing: border-box;
			border-radius: 66dp;
			border: 4dp #ffffff14;
			border-top-color: var(--accent);
			border-right-color: #3fd9c866;
			animation: 1.1s spin infinite linear;
		}
		.orb .core
		{
			position: absolute; top: 30dp; left: 30dp;
			width: 72dp; height: 72dp;
			border-radius: 36dp;
			decorator: radial-gradient(circle 36dp at 50% 50%, #3fd9c8aa, #3fd9c800);
			animation: 1.2s pulse infinite alternate cubic-in-out;
		}
		.orb.done .ring { border-color: var(--accent); animation: none; }
		.orb.fail .ring { border-color: var(--danger); animation: none; }
		.orb.fail .core { decorator: radial-gradient(circle 36dp at 50% 50%, #ff6b7888, #ff6b7800); animation: none; }

		.steps
		{
			margin: var(--s7) auto 0dp auto;
			width: 760dp;
			display: flex;
			flex-direction: row;
			align-items: center;
		}
		.step { display: flex; flex-direction: column; align-items: center; width: 160dp; }
		.step .dot
		{
			width: 22dp; height: 22dp; border-radius: 11dp;
			border: 2dp var(--line-hi);
			background-color: var(--bg-raised);
			transition: background-color border-color 0.3s cubic-out;
		}
		.step .label { margin-top: var(--s3); font-size: var(--t-sm); font-weight: 600; color: var(--text-3); transition: color 0.3s cubic-out; }
		.step.active .dot { border-color: var(--accent); background-color: var(--accent-soft); animation: 0.8s pulse infinite alternate; }
		.step.active .label { color: var(--text); }
		.step.done .dot { border-color: var(--accent); background-color: var(--accent); }
		.step.done .label { color: var(--text-2); }
		.link { flex: 1; height: 3dp; margin-bottom: 34dp; border-radius: 2dp; background-color: var(--line-hi); }
		.link.done { background-color: var(--accent); }

		.actions { margin-top: var(--s8); display: flex; flex-direction: row; justify-content: center; gap: var(--s3); }
	</style>
</head>
<body class="solid" data-model="fluvi">
	<div class="topbar">
		<div class="wordmark">Fluvi<span class="dot">.</span></div>
	</div>

	<div class="center">
		<div class="panel enter">
			<div class="orb" data-class-done="conn.stage == 3" data-class-fail="conn.failed">
				<div class="ring"></div>
				<div class="core"></div>
			</div>
			<div class="eyebrow">{{ conn.console }}</div>
			<h1>{{ conn.title }}</h1>
			<div class="detail" data-class-err="conn.failed">{{ conn.detail }}</div>

			<div class="steps" data-if="!conn.failed">
				<div class="step" data-class-active="conn.stage == 0" data-class-done="conn.stage > 0"><div class="dot"></div><div class="label">Provisionando</div></div>
				<div class="link" data-class-done="conn.stage > 0"></div>
				<div class="step" data-class-active="conn.stage == 1" data-class-done="conn.stage > 1"><div class="dot"></div><div class="label">Sessão pronta</div></div>
				<div class="link" data-class-done="conn.stage > 1"></div>
				<div class="step" data-class-active="conn.stage == 2" data-class-done="conn.stage > 2"><div class="dot"></div><div class="label">Conectado</div></div>
			</div>

			<div class="actions">
				<button class="autofocus" id="connecting-cancel" data-if="!conn.failed" data-event-click="cancel_connect">Cancelar</button>
				<button class="primary autofocus" id="connecting-back" data-if="conn.failed" data-event-click="cancel_connect">Voltar aos consoles</button>
			</div>
		</div>
	</div>
</body>
</rml>
