<rml>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<head>
	<title>Conectando</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		/* Layout only: values come from theme.rcss tokens. */
		.panel
		{
			position: absolute;
			left: var(--margin); right: var(--margin);
			top: 0dp; bottom: 0dp;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}
		.where { font-size: var(--t-lg); }
		.where-skeleton { width: 220dp; }
		.panel h1 { margin-top: var(--s2); }
		.detail { margin-top: var(--s4); width: 900dp; }
		.detail.err { color: var(--danger-text); }
		.detail-skeleton { margin-top: var(--s4); width: 640dp; }

		/* The current: the session flows from the console to this screen, station by station.
		   This is the one place the lantern moves. */
		.current { margin-top: var(--s10); width: 1240dp; display: flex; flex-direction: row; align-items: center; }
		.station { position: relative; width: 26dp; height: 26dp; }
		.station .dot
		{
			width: 26dp; height: 26dp;
			box-sizing: border-box;
			border-radius: var(--r-pill);
			border: 2dp var(--line-hi);
			background-color: var(--bed);
			transition: background-color border-color var(--d-slow) cubic-out;
		}
		.station .label
		{
			position: absolute;
			top: 44dp; left: -67dp;
			width: 160dp;
			text-align: center;
			font-size: var(--t-sm);
			font-weight: 600;
			color: var(--silt);
			transition: color var(--d-slow) cubic-out;
		}
		.station.active .dot { border-color: var(--brand); background-color: var(--brand-soft); animation: var(--d-spin) breathe infinite alternate cubic-in-out; }
		.station.active .label { color: var(--foam); }
		.station.done .dot { border-color: var(--brand); background-color: var(--brand); box-shadow: var(--glow-done); }
		.station.done .label { color: var(--bank); }

		.reach { position: relative; flex: 1; height: 3dp; margin: 0dp var(--s2h); border-radius: var(--r-hair); background-color: var(--track-dim); }
		.reach .fill { width: 0%; height: 3dp; border-radius: var(--r-hair); background-color: var(--brand); transition: width var(--d-fill) cubic-in-out; }
		.reach.done .fill { width: 100%; }
		.reach .spark
		{
			display: none;
			position: absolute;
			top: -9dp; left: 0%;
			width: 120dp; height: 21dp;
			margin-left: -120dp;
			decorator: radial-gradient(ellipse 60dp 10dp at 100% 50%, var(--brand-spark), var(--brand-half) 40%, var(--brand-clear));
		}
		.reach.active .spark { display: block; animation: var(--d-loop) drift infinite cubic-in-out; }
		@keyframes drift
		{
			from { left: 8%; opacity: 0; }
			25%  { opacity: 1; }
			to   { left: 100%; opacity: 0; }
		}

		.current.fail .station .dot { border-color: var(--danger-dim); background-color: var(--bed); box-shadow: none; animation: none; }
		.current.fail .station.done .dot { border-color: var(--danger); background-color: var(--danger-dim); }
		.current.fail .reach .fill { background-color: var(--danger-mid); }
		.current.fail .reach .spark { display: none; }

		.actions { margin-top: var(--s10); display: flex; flex-direction: row; gap: var(--s3); }
	</style>
</head>
<body class="solid" data-model="fluvi">
	<div class="topbar">
		<div class="brand">
			<div class="brand-mark"><div class="w w1"></div><div class="w w2"></div><div class="w w3"></div></div>
			<div class="brand-name">Fluvi</div>
		</div>
	</div>

	<div class="panel arrive">
		<div class="where label-brand" data-if="!conn.loading">{{ conn.console }}</div>
		<div class="skeleton-line where where-skeleton" data-if="conn.loading"></div>
		<h1>{{ conn.title }}</h1>
		<div class="lead detail" data-if="!conn.loading" data-class-err="conn.failed">{{ conn.detail }}</div>
		<div class="lead detail-skeleton" data-if="conn.loading"><div class="skeleton-line w-80"></div></div>

		<div class="current" data-class-fail="conn.failed">
			<div class="station" data-class-active="conn.stage == 0 &amp;&amp; !conn.failed" data-class-done="conn.stage > 0"><div class="dot"></div><div class="label">Sessão</div></div>
			<div class="reach" data-class-active="conn.stage == 0" data-class-done="conn.stage > 0"><div class="fill"></div><div class="spark"></div></div>
			<div class="station" data-class-active="conn.stage == 1 &amp;&amp; !conn.failed" data-class-done="conn.stage > 1"><div class="dot"></div><div class="label">Canal</div></div>
			<div class="reach" data-class-active="conn.stage == 1" data-class-done="conn.stage > 1"><div class="fill"></div><div class="spark"></div></div>
			<div class="station" data-class-active="conn.stage == 2 &amp;&amp; !conn.failed" data-class-done="conn.stage > 2"><div class="dot"></div><div class="label">Rota</div></div>
			<div class="reach" data-class-active="conn.stage == 2" data-class-done="conn.stage > 2"><div class="fill"></div><div class="spark"></div></div>
			<div class="station" data-class-done="conn.stage == 3"><div class="dot"></div><div class="label">Imagem</div></div>
		</div>

		<div class="actions">
			<button autofocus="" id="connecting-cancel" data-if="!conn.failed" data-event-click="cancel_connect">Cancelar</button>
			<button class="primary" autofocus="" id="connecting-back" data-if="conn.failed" data-event-click="cancel_connect">Voltar aos consoles</button>
		</div>
	</div>

	<div class="hints"><span><span class="keycap">Esc</span>cancela</span></div>
</body>
</rml>
