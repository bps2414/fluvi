<rml>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<head>
	<title>stream</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		/* Layout only: values come from theme.rcss tokens. A transparent document over the live frame. */
		body { background-color: transparent; }

		/* ---- Corner stats (HUD): readable over any game, numbers in fixed boxes so they never shake ---- */
		.hud
		{
			position: absolute;
			box-sizing: border-box;
			padding: var(--s2h) var(--s4);
			border-radius: var(--r-row);
			background-color: var(--bed-veil);
			backdrop-filter: blur(var(--blur-sm));
			border: 1dp var(--glass-line);
			font-size: var(--t-xs);
			color: var(--bank);
		}
		.hud.tl { top: var(--s4); left: var(--s4); }
		.hud.tr { top: var(--s4); right: var(--s4); }
		.hud.bl { bottom: var(--s4); left: var(--s4); }
		.hud.br { bottom: var(--s4); right: var(--s4); }
		.hud .line { display: flex; flex-direction: row; align-items: center; gap: var(--s2); }
		.hud .num { display: inline-block; width: 44dp; text-align: right; font-weight: 600; font-size: var(--t-sm); color: var(--foam); }
		.hud .num.wide { width: 92dp; }
		.hud .unit { margin-right: var(--s2); }
		.hud .full { margin-top: var(--s2); width: 236dp; }
		.hud .kv { display: flex; flex-direction: row; justify-content: space-between; padding: var(--s0) 0dp; }
		.hud .kv .v { font-weight: 600; color: var(--foam); text-align: right; }
		.hud .graph { margin-top: var(--s2); }

		.scrim-side
		{
			position: absolute; top: 0dp; left: 0dp; right: 0dp; bottom: 0dp;
			decorator: linear-gradient(90deg, var(--bed-clear) 35%, var(--scrim));
			animation: var(--d-slow) fade-in cubic-out;
		}

		/* ---- The overlay: a pane of river glass on the right; the game stays visible on the left ---- */
		.glass
		{
			position: absolute;
			top: var(--s4); bottom: var(--s4); right: var(--s4);
			width: var(--panel);
			border-radius: var(--r-panel);
			background-color: var(--glass);
			backdrop-filter: blur(var(--blur-lg));
			border: 1dp var(--glass-line);
			/* No box-shadow: a shadow whose area runs past the screen edge is drawn 16 px lower with its box. */
			animation: var(--d-slow) slide-in cubic-out;
		}
		/* The column lives in an inner box that carries the padding: an absolutely placed flex box does not take its
		   height from top/bottom, and a percentage height would count the panel's padding twice. */
		.glass .column { height: 100%; box-sizing: border-box; padding: var(--s5) var(--s5) var(--s4) var(--s5); display: flex; flex-direction: column; }
		@keyframes slide-in { from { opacity: 0; transform: translateX(40dp); } to { opacity: 1; transform: translateX(0dp); } }

		.head .name { font-size: var(--t-xl); white-space: nowrap; overflow: hidden; }
		.head .meta { margin-top: var(--s1); display: flex; flex-direction: row; align-items: center; gap: var(--s5); color: var(--bank); font-size: var(--t-xs); }
		.head .meta .item { display: flex; flex-direction: row; align-items: center; gap: var(--s1h); }
		.head .meta .icon { font-size: var(--i-sm); }

		.scroll { flex: 1 1 0dp; overflow-y: auto; margin-top: var(--s4); padding-right: var(--s1); }
		.segmented { margin-top: var(--s1); }

		.verdict { margin-top: var(--s5); display: flex; flex-direction: row; align-items: baseline; gap: var(--s2h); }
		.verdict .num { font-size: var(--t-3xl); }
		.verdict .unit { font-size: var(--t-md); color: var(--bank); }
		.verdict .word { margin-left: var(--s3); font-family: "Bricolage Grotesque"; font-weight: bold; font-size: var(--t-lg); }
		.verdict .skeleton-line { width: 220dp; height: var(--t-3xl); margin: 0dp; }
		.verdict-cap { font-size: var(--t-xs); color: var(--silt); }
		.scroll .graph { margin-top: var(--s3); }

		.fps { margin-top: var(--s4); display: flex; flex-direction: row; gap: var(--s1h); }
		.fps .cell { flex: 1; padding: var(--s2h) var(--s3); border-radius: var(--r-row); background-color: var(--water); }
		.fps .v { font-size: var(--t-md); font-weight: 600; }
		.fps .k { font-size: var(--t-xs); color: var(--silt); }
		.fps .cell.gen.live .v { color: var(--brand); }
		.fps .skeleton-line { height: var(--t-md); margin: 0dp; }

		.details { margin-top: var(--s3); }
		.kv { display: flex; flex-direction: row; justify-content: space-between; gap: var(--s4); padding: var(--s1h) 0dp; border-bottom: 1dp var(--line); font-size: var(--t-xs); }
		.kv .k { color: var(--bank); }
		.kv .v { font-weight: 600; text-align: right; }
		.kv .v.good { color: var(--alive); }
		.glass .notice { margin-top: var(--s3); font-size: var(--t-xs); }

		.quick { margin-top: var(--s4); }
		.quick h3 { margin-bottom: var(--s2); }
		.quick .row { min-height: var(--target); padding: var(--s1h) var(--s3) var(--s1h) var(--s4); }
		.quick .control { width: 240dp; }
		.quick .stepper { width: 240dp; }

		.foot { margin-top: var(--s3); display: flex; flex-direction: row; gap: var(--s2); }
		.foot button { flex: 1; padding: 0dp var(--s3); }
		.hint-line { margin-top: var(--s3); display: flex; flex-direction: row; justify-content: center; gap: var(--s5); font-size: var(--t-xs); color: var(--silt); }
		.hint-line .hint { gap: var(--s1h); }
	</style>
</head>
<body data-model="fluvi">
	<!-- Corner stats -->
	<div class="hud" data-if="stream.hud > 0 &amp;&amp; !stream.overlay"
	     data-class-tl="stream.corner == 0" data-class-tr="stream.corner == 1" data-class-bl="stream.corner == 2" data-class-br="stream.corner == 3">
		<div class="line">
			<div class="led" data-class-alive="stream.band == 0" data-class-pale="stream.band == 1" data-class-caution="stream.band == 2" data-class-danger="stream.band == 3"></div>
			<span class="num">{{ stream.latency }}</span><span class="unit">[stream.ms]</span>
			<span class="num">{{ stream.fps_present }}</span><span class="unit">[stream.fps]</span>
		</div>
		<div class="full" data-if="stream.hud == 2">
			<div class="kv"><span>[stream.hud_mode]</span><span class="v">{{ stream.mode }}</span></div>
			<div class="kv"><span>[stream.hud_fps]</span><span class="v">{{ stream.fps_line }}</span></div>
			<div class="kv"><span>[stream.bitrate]</span><span class="v">{{ stream.bitrate }}</span></div>
			<div class="kv"><span>[stream.losses]</span><span class="v">{{ stream.loss_short }}</span></div>
			<div class="graph small"><div class="bar" data-for="b : stream.graph" data-style-height="b + '%'" data-class-now="it_index == stream.graph.size - 1"></div></div>
		</div>
	</div>

	<div class="scrim-side" data-if="stream.overlay"></div>

	<div class="glass" data-if="stream.overlay"><div class="column">
		<div class="head">
			<div class="name display">{{ stream.console }}</div>
			<div class="meta">
				<div class="live item"><div class="led"></div><span>[stream.live]</span></div>
				<div class="item"><span class="icon">&#xE492;</span><span>{{ stream.session }}</span></div>
				<div class="item"><span class="icon">&#xE32E;</span><span>{{ stream.res_out }}</span></div>
			</div>
		</div>

		<div class="scroll">
			<div class="segmented">
				<div class="seg" autofocus="" id="mode-play" data-class-on="!stream.smooth" data-event-click="set_mode(0)">
					<div class="what"><span class="icon">&#xE2DE;</span><span>[stream.mode_play]</span></div>
					<div class="desc">[stream.mode_play_d]</div>
				</div>
				<div class="seg" id="mode-smooth" data-class-on="stream.smooth" data-event-click="set_mode(1)">
					<div class="what"><span class="icon">&#xE6DE;</span><span>[stream.mode_smooth]</span></div>
					<div class="desc">{{ stream.smooth_desc }}</div>
				</div>
			</div>

			<div class="verdict">
				<span class="num condensed" data-if="stream.has_stats">{{ stream.latency }}</span>
				<div class="skeleton-line" data-if="!stream.has_stats"></div>
				<span class="unit">[stream.ms]</span>
				<span class="word" data-if="stream.has_stats" data-class-band-0="stream.band == 0" data-class-band-1="stream.band == 1" data-class-band-2="stream.band == 2" data-class-band-3="stream.band == 3">{{ stream.band_word }}</span>
			</div>
			<div class="verdict-cap">{{ stream.latency_cap }}</div>
			<div class="graph"><div class="bar" data-for="b : stream.graph" data-style-height="b + '%'" data-class-now="it_index == stream.graph.size - 1"></div></div>

			<div class="fps">
				<div class="cell"><div class="v" data-if="stream.has_stats">{{ stream.fps_game }}</div><div class="skeleton-line" data-if="!stream.has_stats"></div><div class="k">[stream.fps_game]</div></div>
				<div class="cell"><div class="v" data-if="stream.has_stats">{{ stream.fps_stream }}</div><div class="skeleton-line" data-if="!stream.has_stats"></div><div class="k">[stream.fps_received]</div></div>
				<div class="cell gen" data-class-live="stream.smooth"><div class="v" data-if="stream.has_stats">{{ stream.fps_gen }}</div><div class="skeleton-line" data-if="!stream.has_stats"></div><div class="k">[stream.fps_generated]</div></div>
				<div class="cell"><div class="v" data-if="stream.has_stats">{{ stream.fps_present }}</div><div class="skeleton-line" data-if="!stream.has_stats"></div><div class="k">[stream.fps_screen]</div></div>
			</div>

			<div class="notice" data-if="stream.warning != ''"><span class="icon">&#xE4E2;</span><span>{{ stream.warning }}</span></div>

			<div class="details">
				<div class="section-head" id="details-head" data-class-open="stream.details" data-event-click="toggle_details"><span>[stream.details]</span><span class="icon">&#xE136;</span></div>
				<div class="section-body" data-if="stream.details">
					<div class="kv"><span class="k">[stream.res_stream]</span><span class="v">{{ stream.res }}</span></div>
					<div class="kv"><span class="k">[stream.bitrate]</span><span class="v">{{ stream.bitrate }}</span></div>
					<div class="kv"><span class="k">[stream.present]</span><span class="v" data-class-good="stream.flip">{{ stream.present }}</span></div>
					<div class="kv"><span class="k">[stream.vrr]</span><span class="v" data-class-good="stream.vrr_on">{{ stream.vrr }}</span></div>
					<div class="kv"><span class="k">[stream.monitor]</span><span class="v">{{ stream.refresh }}</span></div>
					<div class="kv"><span class="k">[stream.timing]</span><span class="v">{{ stream.timing }}</span></div>
					<div class="kv"><span class="k">[stream.losses]</span><span class="v">{{ stream.loss }}</span></div>
				</div>
			</div>

			<div class="quick">
				<div class="row" id="quick-hud" data-setting="hud">
					<div class="label"><div class="t">[stream.quick_hud]</div></div>
					<div class="control"><div class="stepper"><div class="arrow" data-dir="-1">&#xE138;</div><div class="value">{{ set.hud }}</div><div class="arrow" data-dir="1">&#xE13A;</div></div></div>
				</div>
				<div class="row" id="quick-corner" data-setting="corner">
					<div class="label"><div class="t">[stream.quick_corner]</div></div>
					<div class="control"><div class="stepper"><div class="arrow" data-dir="-1">&#xE138;</div><div class="value">{{ set.corner }}</div><div class="arrow" data-dir="1">&#xE13A;</div></div></div>
				</div>
				<div class="row" id="quick-volume" data-setting="volume">
					<div class="label"><div class="t">[stream.quick_volume]</div></div>
					<div class="control"><div class="stepper"><div class="arrow" data-dir="-1">&#xE138;</div><div class="value">{{ set.volume }}</div><div class="arrow" data-dir="1">&#xE13A;</div></div></div>
				</div>
				<div class="row" id="quick-fullscreen" data-setting="fullscreen">
					<div class="label"><div class="t">[stream.quick_fullscreen]</div></div>
					<div class="control"><div class="switch" data-class-on="set.fullscreen_on"><div class="knob"></div></div></div>
				</div>
			</div>
		</div>

		<div class="foot">
			<button id="stream-settings" data-event-click="open_settings"><span class="icon">&#xE272;</span><span>[common.settings]</span></button>
			<button class="danger" id="stream-disconnect" data-event-click="disconnect"><span class="icon">&#xE2E4;</span><span>[stream.disconnect]</span></button>
			<button class="ghost" id="stream-quit" data-event-click="quit"><span class="icon">&#xE3DA;</span><span>[stream.quit_short]</span></button>
		</div>
		<div class="hint-line">
			<span class="hint"><span class="keycap kb">{{ stream.hk_overlay }}</span><span class="keycap gp">[settings.pad_view]</span><span class="keycap gp">[settings.pad_menu]</span><span>[stream.hint_close]</span></span>
			<span class="hint"><span class="keycap">{{ stream.hk_mode }}</span><span>[stream.hint_mode]</span></span>
			<span class="hint"><span class="keycap">{{ stream.hk_hud }}</span><span>[stream.hint_hud]</span></span>
		</div>
	</div></div>

	<div class="veil" id="veil"></div>

	<div class="toast-slot" data-class-on="ui.toast_on"><div class="toast"><span class="icon">&#xE182;</span><span>{{ ui.toast }}</span></div></div>

	<div class="scrim" data-if="ui.confirm_quit">
		<div class="dialog">
			<h2>[common.quit_title]</h2>
			<div class="lead">[common.quit_body]</div>
			<div class="dialog-actions">
				<button id="dlg-stay" data-event-click="cancel_quit"><span>[common.quit_stay]</span></button>
				<button class="danger" id="dlg-quit" data-event-click="confirm_quit"><span class="icon">&#xE3DA;</span><span>[common.quit_confirm]</span></button>
			</div>
		</div>
	</div>
</body>
</rml>
